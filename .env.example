# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# AlloyDB for PostgreSQL Configuration (via bathagent-sa)
DB_HOST=10.x.x.x
DB_PORT=5432
DB_USER=bathagent-sa@PROJECT_ID.iam
DB_PASSWORD=
DB_NAME=bathstuff
DB_SSLMODE=prefer

# MCP Toolbox for Databases Configuration
TOOLBOX_URL=http://localhost:5000

# Wildfire Proxy Integration (:8787)
WILDFIRE_URL=http://localhost:8787
WILDFIRE_API_TOKEN=your_wildfire_agent_token_here
