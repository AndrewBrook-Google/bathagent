# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration (AlloyDB / PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bathstuff

# Set to true to use local SQLite fallback without Postgres container
USE_SQLITE=false
SQLITE_PATH=bathstuff.db

# MCP Toolbox for Databases Configuration
TOOLBOX_URL=http://localhost:5000

# Wildfire Proxy Integration (:8787)
WILDFIRE_URL=http://localhost:8787
WILDFIRE_API_TOKEN=your_wildfire_agent_token_here
